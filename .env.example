DATABASE_URL=postgres://postgres:[password]@db.[project-ref].supabase.co:5432/postgres
PORT=8080

# Optional: enables POST /apply and the /apply form, which create a private
# repo under GITHUB_ORG for an applicant's GitHub username and add them as a
# push collaborator. Leave unset to disable that feature entirely.
GITHUB_TOKEN=
GITHUB_ORG=

# Optional: enables GET /admin/lookup (and cmd/lookup), which looks up a
# candidate's registration + expedition history by user ID or email, gated
# by this shared secret sent as the X-Admin-Token header. Leave unset to
# disable that endpoint entirely. Pick a long random value, not a real
# password.
ADMIN_TOKEN=
